---
interface Props {
  agentId: number;
}

const { agentId } = Astro.props;
---

<div id="chat-root" data-agent-id={agentId} class="flex flex-col h-[calc(100dvh-7.5rem)] sm:h-[calc(100dvh-8rem)] gap-3 sm:gap-4">
  <!-- Agent Summary Card Header -->
  <div class="bg-[#111827] border border-[#1e293b] rounded-xl p-3 sm:p-4 flex flex-wrap items-center justify-between gap-3 shrink-0">
    <div class="flex items-center gap-2.5 sm:gap-3">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-[#1e293b] border border-[#334155] flex items-center justify-center text-primary font-mono font-bold text-xs sm:text-sm shrink-0">
        AI
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 id="agent-header-name" class="font-semibold text-on-surface text-sm sm:text-base truncate max-w-[200px] sm:max-w-none">Cargando agente...</h2>
          <span id="agent-active-badge" class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-tertiary/10 text-tertiary font-semibold">ONLINE</span>
        </div>
        <p id="agent-header-role" class="text-[11px] sm:text-xs text-[#a58c7d] font-mono truncate max-w-[250px] sm:max-w-none">Consultando D1...</p>
      </div>
    </div>

    <!-- Telemetry Pills -->
    <div class="flex items-center gap-1.5 sm:gap-2 font-mono text-[11px] sm:text-xs overflow-x-auto max-w-full pb-0.5">
      <div class="px-2 sm:px-2.5 py-1 rounded bg-[#0b0f17] border border-[#1e293b] flex items-center gap-1.5 shrink-0">
        <span class="text-[#a58c7d]">MODEL:</span>
        <span id="agent-header-model" class="text-secondary font-medium truncate max-w-[120px] sm:max-w-none">Cargando...</span>
      </div>
      <div class="px-2 sm:px-2.5 py-1 rounded bg-[#0b0f17] border border-[#1e293b] flex items-center gap-1.5 shrink-0">
        <span class="text-[#a58c7d]">TEMP:</span>
        <span id="agent-header-temp" class="text-tertiary">0.2</span>
      </div>
      <div class="px-2 sm:px-2.5 py-1 rounded bg-[#0b0f17] border border-[#1e293b] flex items-center gap-1.5 shrink-0">
        <span class="text-[#a58c7d]">CHUNKS:</span>
        <span id="agent-header-docs" class="text-primary">0</span>
      </div>
    </div>
  </div>

  <!-- Mobile Tab Switcher (< lg) -->
  <div class="flex lg:hidden items-center bg-[#111827] p-1 rounded-xl border border-[#1e293b] shrink-0 font-mono text-xs">
    <button
      id="mobile-tab-chat"
      type="button"
      class="flex-1 py-2 px-3 rounded-lg bg-[#f38020] text-[#0b0f17] font-semibold flex items-center justify-center gap-2 transition-all min-h-[40px]"
    >
      <span class="material-symbols-outlined text-[18px]">terminal</span>
      <span>Terminal de Chat</span>
    </button>
    <button
      id="mobile-tab-citations"
      type="button"
      class="flex-1 py-2 px-3 rounded-lg text-[#a58c7d] hover:text-white flex items-center justify-center gap-2 transition-all min-h-[40px]"
    >
      <span class="material-symbols-outlined text-[18px]">fact_check</span>
      <span>Citas RAG</span>
      <span id="mobile-citation-badge" class="px-1.5 py-0.5 rounded-full bg-[#1e293b] text-[10px] text-tertiary font-bold">0</span>
    </button>
  </div>

  <!-- Chat & Citations Main Split Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 sm:gap-4 flex-1 min-h-0">
    <!-- Messages Terminal (Left 2 cols) -->
    <div id="panel-chat-terminal" class="lg:col-span-2 bg-[#0b0f17] border border-[#1e293b] rounded-xl flex flex-col overflow-hidden h-full">
      <!-- Chat Messages Scrollable Log -->
      <div id="chat-messages" class="flex-1 p-3 sm:p-4 overflow-y-auto flex flex-col gap-3 font-mono text-xs">
        <div class="p-3 rounded-lg bg-[#111827] border border-[#1e293b] text-[#cbd5e1] leading-relaxed">
          <div class="flex items-center gap-2 text-primary mb-1">
            <span class="material-symbols-outlined text-[16px]">terminal</span>
            <span class="font-bold">Constitutional Agent Console Ready</span>
          </div>
          Escribe una pregunta sobre la Constitución Política de Colombia. El motor orquestará la recuperación híbrida (Vectorize semántico + D1 FTS5 léxico) y fundamentará la respuesta en los artículos indexados.
        </div>
      </div>

      <!-- Quick Question Suggestions -->
      <div class="px-3 py-2 border-t border-[#1e293b] bg-[#111827]/50 flex items-center gap-2 overflow-x-auto whitespace-nowrap font-mono text-[11px] shrink-0">
        <span class="text-[#a58c7d] text-[10px]">Sugerencias:</span>
        <button type="button" class="quick-prompt-btn px-2.5 py-1.5 rounded-full bg-[#181c24] hover:bg-[#1e293b] text-secondary border border-[#334155] transition-colors min-h-[32px] flex items-center" data-prompt="¿Qué dice el Artículo 11 sobre el derecho a la vida?">
          Art. 11 (Vida)
        </button>
        <button type="button" class="quick-prompt-btn px-2.5 py-1.5 rounded-full bg-[#181c24] hover:bg-[#1e293b] text-secondary border border-[#334155] transition-colors min-h-[32px] flex items-center" data-prompt="¿Cómo funciona la Acción de Tutela según el Artículo 86?">
          Art. 86 (Tutela)
        </button>
        <button type="button" class="quick-prompt-btn px-2.5 py-1.5 rounded-full bg-[#181c24] hover:bg-[#1e293b] text-secondary border border-[#334155] transition-colors min-h-[32px] flex items-center" data-prompt="¿Cuáles son los fines esenciales del Estado en el Artículo 2?">
          Art. 2 (Fines del Estado)
        </button>
      </div>

      <!-- Input Bar -->
      <form id="chat-form" class="p-2.5 sm:p-3 bg-[#111827] border-t border-[#1e293b] flex items-center gap-2 shrink-0">
        <input
          type="text"
          id="chat-input"
          placeholder="Consultar artículo o derecho..."
          required
          class="flex-1 bg-[#0b0f17] border border-[#1e293b] rounded-lg px-3 py-2.5 text-[16px] sm:text-xs font-mono text-on-surface placeholder-[#64748b] focus:outline-none focus:border-primary transition-colors min-h-[44px]"
        />
        <button
          type="submit"
          id="chat-send-btn"
          class="flex items-center justify-center gap-1.5 px-3.5 sm:px-4 py-2.5 bg-[#f38020] hover:bg-[#fb923c] text-[#0b0f17] font-semibold text-xs font-mono rounded-lg transition-colors shadow-[0_0_10px_rgba(243,128,32,0.3)] disabled:opacity-50 min-h-[44px] shrink-0"
        >
          <span class="material-symbols-outlined text-[18px]">send</span>
          <span class="hidden xs:inline">Consultar</span>
        </button>
      </form>
    </div>

    <!-- Citations & Grounding Context Inspector (Right 1 col) -->
    <div id="panel-citations-inspector" class="hidden lg:flex bg-[#111827] border border-[#1e293b] rounded-xl flex-col overflow-hidden h-full">
      <div class="p-3 border-b border-[#1e293b] flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2 text-on-surface font-semibold text-xs">
          <span class="material-symbols-outlined text-[16px] text-tertiary">fact_check</span>
          <span>Citas y Fundamentación RAG</span>
        </div>
        <span id="citation-count" class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-[#1e293b] text-[#a58c7d]">0 citas</span>
      </div>

      <div id="citations-list" class="flex-1 p-3 overflow-y-auto flex flex-col gap-3 font-mono text-xs">
        <div class="text-center text-[#a58c7d] py-12 px-4">
          <span class="material-symbols-outlined text-3xl text-[#334155] mb-2">article</span>
          <p>Los fragmentos normativos recuperados de D1 y Vectorize aparecerán aquí para verificar el sustento constitucional de cada respuesta.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { marked } from 'marked';
  import { apiClient } from '../services/client/apiClient';
  import type { RetrievedChunk } from '../types';

  marked.setOptions({
    gfm: true,
    breaks: true
  });

  const root = document.getElementById('chat-root');
  const agentId = Number(root?.dataset.agentId);

  const headerName = document.getElementById('agent-header-name');
  const headerRole = document.getElementById('agent-header-role');
  const headerModel = document.getElementById('agent-header-model');
  const headerTemp = document.getElementById('agent-header-temp');
  const headerDocs = document.getElementById('agent-header-docs');

  const chatMessages = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form') as HTMLFormElement;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const sendBtn = document.getElementById('chat-send-btn') as HTMLButtonElement;
  const citationsList = document.getElementById('citations-list');
  const citationCount = document.getElementById('citation-count');

  // Mobile Tabs Elements
  const tabChat = document.getElementById('mobile-tab-chat');
  const tabCitations = document.getElementById('mobile-tab-citations');
  const panelChat = document.getElementById('panel-chat-terminal');
  const panelCitations = document.getElementById('panel-citations-inspector');
  const mobileCitationBadge = document.getElementById('mobile-citation-badge');

  function switchMobileTab(active: 'chat' | 'citations') {
    if (!tabChat || !tabCitations || !panelChat || !panelCitations) return;

    if (active === 'chat') {
      tabChat.className = 'flex-1 py-2 px-3 rounded-lg bg-[#f38020] text-[#0b0f17] font-semibold flex items-center justify-center gap-2 transition-all min-h-[40px]';
      tabCitations.className = 'flex-1 py-2 px-3 rounded-lg text-[#a58c7d] hover:text-white flex items-center justify-center gap-2 transition-all min-h-[40px]';
      panelChat.classList.remove('hidden');
      panelChat.classList.add('flex');
      panelCitations.classList.add('hidden');
      panelCitations.classList.remove('flex');
    } else {
      tabCitations.className = 'flex-1 py-2 px-3 rounded-lg bg-[#f38020] text-[#0b0f17] font-semibold flex items-center justify-center gap-2 transition-all min-h-[40px]';
      tabChat.className = 'flex-1 py-2 px-3 rounded-lg text-[#a58c7d] hover:text-white flex items-center justify-center gap-2 transition-all min-h-[40px]';
      panelChat.classList.add('hidden');
      panelChat.classList.remove('flex');
      panelCitations.classList.remove('hidden');
      panelCitations.classList.add('flex');
    }
  }

  tabChat?.addEventListener('click', () => switchMobileTab('chat'));
  tabCitations?.addEventListener('click', () => switchMobileTab('citations'));

  let currentAgentModel = '';

  function formatModelLabel(modelId?: string): string {
    if (!modelId) return 'Workers AI';
    if (modelId.includes('llama-4-scout')) return 'Llama 4 Scout';
    if (modelId.includes('llama-3.1-8b')) return 'Llama 3.1 8B';
    if (modelId.includes('mistral-7b')) return 'Mistral 7B';
    const parts = modelId.split('/');
    return parts[parts.length - 1] || modelId;
  }

  async function loadAgentDetails() {
    try {
      const agent = await apiClient.getAgente(agentId);
      currentAgentModel = agent.modelo;
      if (headerName) headerName.textContent = agent.nombre;
      if (headerRole) headerRole.textContent = `${agent.rol} | slug: ${agent.slug}`;
      if (headerModel) {
        headerModel.textContent = formatModelLabel(agent.modelo);
        headerModel.title = agent.modelo;
      }
      if (headerTemp) headerTemp.textContent = String(agent.temperatura ?? 0.2);
      if (headerDocs) headerDocs.textContent = String(agent.documentosCount ?? 0);
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Error al cargar detalles del agente';
      if (headerName) headerName.textContent = `Error: ${message}`;
    }
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function appendUserMessage(text: string) {
    if (!chatMessages) return;
    const msgDiv = document.createElement('div');
    msgDiv.className = 'self-end max-w-[85%] p-3 rounded-lg bg-[#1e293b] border border-[#334155] text-on-surface';
    msgDiv.innerHTML = `
      <div class="flex items-center gap-1.5 text-primary text-[10px] mb-1 font-bold">
        <span class="material-symbols-outlined text-[14px]">person</span>
        <span>Ciudadano / Consultante</span>
      </div>
      <p class="whitespace-pre-wrap">${escapeHtml(text)}</p>
    `;
    chatMessages.appendChild(msgDiv);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  async function appendAgentMessage(text: string, isLiveAI: boolean, modelName?: string) {
    if (!chatMessages) return;
    const msgDiv = document.createElement('div');
    msgDiv.className = 'self-start max-w-[90%] p-3.5 rounded-lg bg-[#111827] border border-[#1e293b] text-[#dfe2ee] leading-relaxed';
    
    let renderedHtml = '';
    try {
      renderedHtml = await marked.parse(text);
    } catch {
      renderedHtml = escapeHtml(text);
    }

    const effectiveModel = modelName || currentAgentModel;
    const modelLabel = formatModelLabel(effectiveModel);
    const badgeText = isLiveAI ? `Workers AI • ${modelLabel}` : 'D1 Grounded Fallback';

    msgDiv.innerHTML = `
      <div class="flex items-center justify-between gap-2 text-tertiary text-[10px] mb-2 font-bold font-mono">
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">gavel</span>
          <span>Respuesta Constitucional Grounded</span>
        </div>
        <span class="text-[9px] px-1.5 py-0.5 rounded ${isLiveAI ? 'bg-secondary/10 text-secondary' : 'bg-primary/10 text-primary'}" title="${escapeHtml(effectiveModel || '')}">
          ${escapeHtml(badgeText)}
        </span>
      </div>
      <div class="chat-markdown-body text-xs leading-relaxed font-sans">${renderedHtml}</div>
    `;
    chatMessages.appendChild(msgDiv);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function renderCitations(citations: RetrievedChunk[]) {
    if (!citationsList || !citationCount) return;
    citationCount.textContent = `${citations.length} citas`;

    if (mobileCitationBadge) {
      mobileCitationBadge.textContent = String(citations.length);
      if (citations.length > 0) {
        mobileCitationBadge.className = 'px-1.5 py-0.5 rounded-full bg-tertiary/20 text-[10px] text-tertiary font-bold';
      } else {
        mobileCitationBadge.className = 'px-1.5 py-0.5 rounded-full bg-[#1e293b] text-[10px] text-[#a58c7d] font-bold';
      }
    }

    if (citations.length === 0) {
      citationsList.innerHTML = `
        <div class="text-center text-[#a58c7d] py-6">
          <p>No se encontraron fragmentos normativos para esta consulta específica.</p>
        </div>
      `;
      return;
    }

    citationsList.innerHTML = citations
      .map(
        (c) => `
        <div class="p-2.5 rounded-lg bg-[#0b0f17] border-l-2 border-l-[#06b6d4] border-t border-r border-b border-[#1e293b]">
          <div class="flex items-center justify-between gap-1 mb-1">
            <span class="font-semibold text-secondary text-xs truncate">${c.titulo}</span>
            <span class="text-[9px] px-1 rounded bg-[#181c24] text-tertiary font-mono">
              ${c.origen === 'vectorial' ? 'VECTOR' : 'FTS5'}
            </span>
          </div>
          <p class="text-[11px] text-[#cbd5e1] leading-normal line-clamp-4">${c.contenido}</p>
        </div>
      `
      )
      .join('');
  }

  chatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const pregunta = chatInput.value.trim();
    if (!pregunta) return;

    chatInput.value = '';
    appendUserMessage(pregunta);

    sendBtn.disabled = true;
    sendBtn.innerHTML = `<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span><span>Pensando...</span>`;

    try {
      const data = (await apiClient.consultarRag(agentId, pregunta)) as {
        respuesta: string;
        isLiveAI: boolean;
        citas?: RetrievedChunk[];
        agente?: { modelo?: string };
        modeloUsado?: string;
      };
      const modelUsed = data.modeloUsado || data.agente?.modelo || currentAgentModel;
      await appendAgentMessage(data.respuesta, data.isLiveAI, modelUsed);
      if (data.citas) {
        renderCitations(data.citas);
      }
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Error desconocido al consultar';
      await appendAgentMessage(`Error al consultar: ${message}`, false);
    } finally {
      sendBtn.disabled = false;
      sendBtn.innerHTML = `<span class="material-symbols-outlined text-[16px]">send</span><span>Consultar</span>`;
    }
  });

  // Quick suggestion clicks
  document.querySelectorAll('.quick-prompt-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const prompt = target.dataset.prompt;
      if (prompt && chatInput) {
        chatInput.value = prompt;
        chatForm.dispatchEvent(new Event('submit'));
      }
    });
  });

  loadAgentDetails();
</script>

<style is:global>
  .chat-markdown-body {
    color: #dfe2ee;
  }
  .chat-markdown-body p {
    margin-bottom: 0.75rem;
  }
  .chat-markdown-body p:last-child {
    margin-bottom: 0;
  }
  .chat-markdown-body h1,
  .chat-markdown-body h2,
  .chat-markdown-body h3,
  .chat-markdown-body h4 {
    color: #ffb787;
    font-weight: 700;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .chat-markdown-body h1 { font-size: 1.15rem; }
  .chat-markdown-body h2 { font-size: 1.05rem; }
  .chat-markdown-body h3 { font-size: 0.95rem; }
  .chat-markdown-body h4 { font-size: 0.875rem; }
  .chat-markdown-body strong {
    color: #ffffff;
    font-weight: 700;
  }
  .chat-markdown-body em {
    color: #4cd7f6;
    font-style: italic;
  }
  .chat-markdown-body ul {
    list-style-type: disc;
    margin-left: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .chat-markdown-body ol {
    list-style-type: decimal;
    margin-left: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .chat-markdown-body li {
    margin-bottom: 0.25rem;
  }
  .chat-markdown-body blockquote {
    border-left: 3px solid #f38020;
    padding-left: 0.75rem;
    color: #94a3b8;
    margin: 0.75rem 0;
    font-style: italic;
  }
  .chat-markdown-body code {
    background-color: #1e293b;
    color: #4cd7f6;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
  }
  .chat-markdown-body pre {
    background-color: #0b0f17;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    padding: 0.75rem;
    overflow-x: auto;
    margin: 0.75rem 0;
  }
  .chat-markdown-body pre code {
    background-color: transparent;
    padding: 0;
    color: #4edea3;
  }
  .chat-markdown-body hr {
    border: none;
    border-top: 1px solid #1e293b;
    margin: 1rem 0;
  }
  .chat-markdown-body a {
    color: #4cd7f6;
    text-decoration: underline;
  }
</style>

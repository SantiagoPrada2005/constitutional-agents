---
import Layout from '../../layouts/Layout.astro';
import ChatInterface from '../../components/ChatInterface.astro';

const { id } = Astro.params;
const agentId = Number(id) || 1;
---

<Layout title={`Consola RAG Constitucional | Agente #${agentId}`} activePath="/chat">
  <div class="flex flex-col gap-2">
    <div class="flex items-center gap-2 font-mono text-xs text-[#a58c7d] mb-1">
      <a href="/" class="hover:text-white transition-colors">Gestión de Agentes</a>
      <span>/</span>
      <span class="text-primary">Consola RAG Agente #{agentId}</span>
    </div>

    <ChatInterface agentId={agentId} />
  </div>
</Layout>
